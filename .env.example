# ─── Database ────────────────────────────────────────────────────────────────
# Two connection strings, one consumer each. See docs/adr/0002.
#   DATABASE_URL  pooled   — every runtime query, through the pg driver adapter
#   DIRECT_URL    direct   — the Prisma CLI only: migrations need a stable session
#
# Locally both point at the Docker container. These credentials exist only there.
DATABASE_URL="postgresql://evidence:evidence@localhost:5432/evidence_dev"
DIRECT_URL="postgresql://evidence:evidence@localhost:5432/evidence_dev"

# The test suite's own database, in the same container. Local only: never set in production
TEST_DATABASE_URL="postgresql://evidence:evidence@localhost:5432/evidence_test"

# In production, Neon's two strings. The pooled host ends in -pooler:
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# ─── Session ─────────────────────────────────────────────────────────────────
# At least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-this-with-at-least-thirty-two-characters"

# ─── Object storage — Cloudflare R2 ──────────────────────────────────────────
# The bucket must be private, with no public domain enabled, with CORS allowing
# PUT and GET from the web client's origin, and a lifecycle rule expiring the
# pending/ prefix after 1 day.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="evidence-manager"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Upload policy ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES="5242880"
ALLOWED_MIME_TYPES="image/jpeg,image/png,application/pdf"

# ─── Runtime ─────────────────────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"
PORT="3001"
NODE_ENV="development"
